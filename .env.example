# Notion
NOTION_TOKEN=secret_xxx
NOTION_AMA_DATABASE_ID=
NOTION_DESIGN_DETAILS_EPISODES_DATABASE_ID=
NOTION_GOOD_WEBSITES_DATABASE_ID=
NOTION_MUSIC_DATABASE_ID=
NOTION_SITE_IDEAS_DATABASE_ID=
NOTION_SPEAKING_DATABASE_ID=
NOTION_STACK_DATABASE_ID=
NOTION_TIL_DATABASE_ID=
# Secret for authenticating Notion automation webhooks
# Configure in Notion automation: Add header "x-webhook-secret" with this value
NOTION_WEBHOOK_VERIFICATION_SECRET=
NOTION_WRITING_DATABASE_ID=
NOTION_APP_DISSECTION_DATABASE_ID=

# AWS (for S3/migrations)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_S3_API_URL=

# Upstash Redis (HN subscribers + cheap /api/hn INCR rate limit).
# Do not point other high-churn caches at this PAYG database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash Redis (HN post cache)
UPSTASH_HN_CACHE_REST_URL=
UPSTASH_HN_CACHE_REST_TOKEN=

# Upstash Redis (Notion content cache)
UPSTASH_NOTION_CACHE_REST_URL=
UPSTASH_NOTION_CACHE_REST_TOKEN=

# Upstash Redis (Likes)
UPSTASH_LIKES_REST_URL=
UPSTASH_LIKES_REST_TOKEN=

# Upstash Redis (Activity feed). Optional — if unset, likes Redis is reused
# with an `activity:` key prefix. Do not point this at the HN rate-limit DB.
UPSTASH_ACTIVITY_REST_URL=
UPSTASH_ACTIVITY_REST_TOKEN=

# HMAC secret for POST /api/activity (later external producers)
ACTIVITY_INGEST_HMAC_SECRET=

# Shared token for POST /api/activity/caffeine (iOS Shortcut).
# Send as `Authorization: Bearer <token>` or `x-activity-token`.
# Set the same value in Vercel (Production + Preview). Do not commit a real token.
ACTIVITY_CAFFEINE_TOKEN=

# Likes system
LIKES_HASH_SALT=
LIKES_SYNC_TOKEN=

# Auth
JWT_SIGNING_KEY=
ADMIN_USER_ID=

# External APIs
HN_TOKEN=
POSTMARK_CLIENT_ID=

# Upstash Redis (HN CLI Telemetry)
UPSTASH_HN_CLI_TELEMETRY_REST_URL=
UPSTASH_HN_CLI_TELEMETRY_REST_TOKEN=

# --- Spotify sync ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# OAuth callback registered in the Spotify app dashboard
SPOTIFY_REDIRECT_URI=https://brianlovin.com/api/spotify/callback
# Notion DB holding the single "Spotify Refresh Token" row
SPOTIFY_TOKEN_DATABASE_ID=
# Absolute URL QStash calls to process each track (must be publicly reachable)
SPOTIFY_WORKER_URL=https://brianlovin.com/api/spotify/worker

# --- QStash (Spotify sync fan-out) ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Sentry ---
# Runtime DSN (public). Required for error capture / spotify-sync alerts.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only: auth token for uploading source maps (optional but recommended)
SENTRY_AUTH_TOKEN=

# --- Vercel Cron auth (hn-digest + spotify sync) ---
CRON_SECRET=
